<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Network Engineering Laboratory I — NETLab</title>
<link rel="stylesheet" href="styles/tokens.css">
<link rel="stylesheet" href="styles/shared.css">
<style>
body{min-height:100vh}
.topbar{height:56px;gap:10px}

.overview{max-width:1080px;margin:0 auto;padding:var(--space-6) var(--space-5) var(--space-3)}
.ov-tag{display:inline-flex;font-size:var(--step-xs);font-weight:700;padding:4px 10px;border-radius:8px;background:rgba(217,119,87,.12);color:var(--cyan);letter-spacing:.06em;margin-bottom:var(--space-4)}
.ov-title{font-size:27px;font-weight:800;letter-spacing:-0.015em;margin-bottom:var(--space-3);line-height:1.3;text-wrap:balance}
.ov-desc{font-size:var(--step-md);color:var(--text2);line-height:1.75;max-width:760px}
.ov-stats{display:flex;gap:var(--space-5);margin-top:var(--space-5);flex-wrap:wrap}
.ov-stat b{display:block;font-size:var(--step-2xl);color:var(--cyan)}
.ov-stat span{font-size:var(--step-xs);color:var(--text3)}
.ov-actions{display:flex;gap:var(--space-3);margin-top:var(--space-5);flex-wrap:wrap}
.progress-wrap{max-width:1080px;margin:var(--space-5) auto 0;padding:0 var(--space-5)}
.progress-label{display:flex;justify-content:space-between;font-size:var(--step-sm);color:var(--text2);margin-bottom:var(--space-2)}
.progress-bar{height:8px;background:var(--panel2);border:1px solid var(--border);border-radius:5px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--cyan),var(--green));border-radius:5px}

.lab-section{max-width:1080px;margin:var(--space-6) auto var(--space-8);padding:0 var(--space-5)}
.lab-section-title{font-size:var(--step-md);font-weight:700;margin-bottom:var(--space-3)}
.lab-list{display:flex;flex-direction:column;gap:var(--space-3)}
.lab-row{display:flex;align-items:center;gap:var(--space-4);background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:var(--space-4);text-decoration:none;color:var(--text);transition:border-color .12s}
.lab-row.clickable:hover{border-color:var(--cyan)}
.lab-row.clickable:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.lab-row.locked{opacity:.55;cursor:not-allowed}
.lab-num{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:var(--step-sm);flex-shrink:0}
.ln-done{background:var(--green-l);color:var(--green)}
.ln-active{background:var(--cyan-wash);color:var(--cyan);border:1px solid var(--cyan-d)}
.ln-locked{background:var(--panel2);color:var(--text3)}
.lab-info{flex:1;min-width:0}
.lab-title{font-size:var(--step-base);font-weight:600}
.lab-sub{font-size:var(--step-xs);color:var(--text3);margin-top:2px}
.lab-status{font-size:var(--step-xs);font-weight:700;padding:4px 10px;border-radius:8px;flex-shrink:0;white-space:nowrap}
.ls-done{background:var(--green-l);color:var(--green)}
.ls-active{background:var(--cyan-wash);color:var(--cyan)}
.ls-locked{background:var(--panel2);color:var(--text3)}
.footer-note{max-width:1080px}
@media (max-width:640px){
  .ov-title{font-size:21px}
  .lab-row{padding:12px 14px;gap:12px}
  .lab-sub{display:none}
  .topbar .crumb{display:none}
}
</style>
</head>
<body>

<div class="topbar">
  <a class="brand" href="index.html">NET<span>Lab</span></a>
  <span class="crumb-sep">›</span>
  <a class="crumb" href="labs.html">Lab</a>
  <span class="crumb-sep">›</span>
  <span class="crumb current">Network Engineering Laboratory I</span>
  <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="สลับโหมดสี Day/Night">🌙</button>
</div>

<div class="overview">
  <span class="ov-tag">รายวิชาปฏิบัติการ</span>
  <div class="ov-title">Network Engineering Laboratory I</div>
  <div class="ov-desc">การฝึกปฏิบัติการ การรับส่งสารสนเทศ การสื่อสารข้อมูล การกำหนดค่าต่าง ๆ ให้กับอุปกรณ์เราเตอร์ การกำหนดค่าโปรโตคอลเลือกเส้นทาง ได้แก่ Static route default route rip ospf eigrp เรื่องอื่น ๆ ที่สัมพันธ์กับเนื้อหาวิชาทางด้านเทคโนโลยีเครือข่าย</div>
  <div class="ov-stats">
    <div class="ov-stat"><b>11</b><span>Labs ทั้งหมด</span></div>
    <div class="ov-stat"><b>4</b><span>เรียนจบแล้ว</span></div>
    <div class="ov-stat"><b>36%</b><span>ความคืบหน้ารวม</span></div>
  </div>
  <div class="ov-actions">
    <a class="btn-primary" href="lab5.html">▶ ไปต่อที่ Lab 5 (กำลังเรียน)</a>
    <a class="btn-secondary" href="dashboard.html">📊 ดู Dashboard</a>
  </div>
</div>

<div class="progress-wrap">
  <div class="progress-label"><span>ความคืบหน้ารายวิชา</span><span>4/11 Labs</span></div>
  <div class="progress-bar"><div class="progress-fill" style="width:36%"></div></div>
</div>

<div class="lab-section">
  <div class="lab-section-title">Lab ทั้งหมดในรายวิชา</div>
  <div class="lab-list" id="labList"></div>
</div>

<div class="footer-note">ระบบจำลองเพื่อการศึกษา — ไม่มีความเกี่ยวข้องกับ Cisco Networking Academy (NetAcad)</div>

<script>
'use strict';
var LABS=[
  {n:1,title:'Course Introduction and Basic Network Knowledge Review',status:'done'},
  {n:2,title:'UTP CAT5 Cable Termination, RJ45, Keystone Jack and Patch Panel',status:'done'},
  {n:3,title:'IP Address และ Subnet IPv4',status:'done'},
  {n:4,title:'Basic Configuration',status:'done'},
  {n:5,title:'Static Route',status:'active',href:'lab5.html'},
  {n:6,title:'RIP v1',status:'locked'},
  {n:7,title:'RIP v2',status:'locked'},
  {n:8,title:'EIGRP',status:'locked'},
  {n:9,title:'OSPF',status:'locked'},
  {n:10,title:'Redistribution',status:'locked'},
  {n:11,title:'BGP',status:'locked'}
];
var STATUS_LABEL={done:'เรียนจบแล้ว',active:'กำลังเรียน',locked:'ยังไม่ปลดล็อก'};

function renderLabs(){
  var cont=document.getElementById('labList');
  cont.innerHTML=LABS.map(function(l){
    var numClass=l.status==='done'?'ln-done':l.status==='active'?'ln-active':'ln-locked';
    var statusClass=l.status==='done'?'ls-done':l.status==='active'?'ls-active':'ls-locked';
    var icon=l.status==='done'?'✓':l.status==='locked'?'🔒':l.n;
    var clickable=(l.status==='done'||l.status==='active')&&l.href;
    var tag=clickable?'a':'div';
    var hrefAttr=clickable?' href="'+l.href+'"':'';
    return '<'+tag+' class="lab-row'+(clickable?' clickable':'')+(l.status==='locked'?' locked':'')+'"'+hrefAttr+'>'
      +'<div class="lab-num '+numClass+'">'+icon+'</div>'
      +'<div class="lab-info"><div class="lab-title">Lab '+l.n+' — '+l.title+'</div>'
      +'<div class="lab-sub">'+(l.status==='locked'?'ปลดล็อกหลังเรียน Lab '+(l.n-1)+' จบ':'Network Engineering Laboratory I')+'</div></div>'
      +'<div class="lab-status '+statusClass+'">'+STATUS_LABEL[l.status]+'</div>'
      +'</'+tag+'>';
  }).join('');
}
renderLabs();
</script>
<script src="scripts/theme.js"></script>
</body>
</html>
