# NETLab backend config. On the server: copy to /opt/netlab/.env, fill in every
# value, then `chmod 600 .env` so only the netlab user can read it.

# AI tutor (OpenRouter). Same key as local dev is fine.
OPENROUTER_API_KEY=
MODEL_DEFAULT=google/gemini-2.5-flash
MODEL_FAST=google/gemini-2.5-flash
MODEL_FALLBACK=qwen/qwen3-32b

# Same-origin through nginx, so only the site's own https origin is needed.
ALLOWED_ORIGINS=https://netlab.example.ac.th

# Google Sign-In. Must equal the client_id in frontend/src/pages/login/Login.tsx.
GOOGLE_CLIENT_ID=235099944918-3eak8o4eodg86v0nhfs479nhvmkpui75.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=email.kmutnb.ac.th

# Session-token signing key. Generate a NEW one on the server, never reuse the dev key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later signs every student out (they just log in again).
SECRET_KEY=
