# NETLab backend — systemd unit. Copy to /etc/systemd/system/netlab-backend.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now netlab-backend
#   sudo systemctl status netlab-backend      # logs: journalctl -u netlab-backend -f

[Unit]
Description=NETLab backend (FastAPI + AI tutor proxy)
After=network-online.target
Wants=network-online.target

[Service]
User=netlab
Group=netlab
# main.py reads .env from next to itself, and db.py keeps netlab.db there too
WorkingDirectory=/opt/netlab
# 127.0.0.1 only: students reach the backend through nginx's /api/, never directly
ExecStart=/opt/netlab/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
